+void reshade::runtime::s2fm_begin_frame(const s2fm_clock &clock)
+{
+	if (!_is_initialized)
+		return;
+
+	// update_effects loads every effect when the frame count is 0, so it sees the count of frames begun.
+	_frame_count = _s2fm_frames++;
+	update_effects();
+
+	_current_time = std::chrono::system_clock::now();
+	_last_present_time = _start_time + std::chrono::duration_cast<std::chrono::high_resolution_clock::duration>(std::chrono::duration<double>(clock.seconds));
+	_last_frame_duration = std::chrono::duration_cast<std::chrono::high_resolution_clock::duration>(std::chrono::duration<double, std::milli>(clock.frame_time_ms));
+	_frame_count = clock.frame_count;
+	std::srand(clock.random_seed);
+}
+
+void reshade::runtime::s2fm_render_stage(api::command_list *cmd_list, api::resource_view rtv, api::resource_view rtv_srgb, const std::vector<bool> &techniques)
+{
+	if (!_is_initialized)
+		return;
+
+	capture_state(cmd_list, _app_state);
+	_s2fm_filter = &techniques;
+	_effects_rendered_this_frame = false;
+	render_effects(cmd_list, rtv, rtv_srgb);
+	_s2fm_filter = nullptr;
+	apply_state(cmd_list, _app_state);
+}
+
+size_t reshade::runtime::s2fm_technique_index(api::effect_technique handle) const
+{
+	return reinterpret_cast<const technique *>(handle.handle) - _techniques.data();
+}
+size_t reshade::runtime::s2fm_technique_count() const
+{
+	return _techniques.size();
+}
+reshade::runtime::s2fm_technique_facts reshade::runtime::s2fm_technique_info(api::effect_technique handle) const
+{
+	s2fm_technique_facts facts;
+	const technique *tech = reinterpret_cast<const technique *>(handle.handle);
+	if (tech == nullptr || tech->effect_index >= _effects.size())
+		return facts;
+	const effect &effect = _effects[tech->effect_index];
+	facts.name = tech->name;
+	facts.file = effect.source_file.filename().u8string();
+	facts.compiled = effect.compiled;
+	if (effect.permutations.empty() || tech->permutations.empty())
+		return facts;
+	const reshadefx::effect_module &module = effect.permutations[0].module;
+	const auto declared_name = [&module](const std::string &unique_name, std::string *semantic) -> std::string {
+		for (const reshadefx::texture &tex : module.textures)
+			if (tex.unique_name == unique_name)
+				return *semantic = tex.semantic, tex.name;
+		return *semantic = std::string(), unique_name;
+	};
+	for (const reshadefx::pass &pass : tech->permutations[0].passes)
+	{
+		for (const reshadefx::texture_binding &binding : pass.texture_bindings)
+		{
+			if (binding.index >= module.samplers.size())
+				continue;
+			std::string semantic;
+			const std::string name = declared_name(module.samplers[binding.index].texture_name, &semantic);
+			if (semantic == "DEPTH")
+				facts.reads_depth = true;
+			else if (semantic.empty() && std::find(facts.reads.begin(), facts.reads.end(), name) == facts.reads.end())
+				facts.reads.push_back(name);
+		}
+		for (const std::string &target : pass.render_target_names)
+		{
+			std::string semantic;
+			if (!target.empty())
+			{
+				const std::string name = declared_name(target, &semantic);
+				if (semantic.empty() && std::find(facts.writes.begin(), facts.writes.end(), name) == facts.writes.end())
+					facts.writes.push_back(name);
+			}
+		}
+		for (const reshadefx::storage_binding &binding : pass.storage_bindings)
+		{
+			if (binding.index >= module.storages.size())
+				continue;
+			std::string semantic;
+			const std::string name = declared_name(module.storages[binding.index].texture_name, &semantic);
+			if (semantic.empty() && std::find(facts.writes.begin(), facts.writes.end(), name) == facts.writes.end())
+				facts.writes.push_back(name);
+		}
+	}
+	return facts;
+}
+std::vector<std::pair<std::string, std::string>> reshade::runtime::s2fm_effect_definitions(const std::string &effect_file) const
+{
+	for (const effect &effect : _effects)
+		if (effect.source_file.filename().u8string() == effect_file)
+			return effect.definitions;
+	return {};
+}
+std::string reshade::runtime::s2fm_effect_errors(const std::string &effect_file) const
+{
+	for (const effect &effect : _effects)
+		if (effect.source_file.filename().u8string() == effect_file)
+			return effect.errors;
+	return {};
+}
+std::string reshade::runtime::s2fm_errors() const
+{
+	std::string result;
+	for (const effect &effect : _effects)
+	{
+		if (effect.errors.empty() && (effect.compiled || effect.skipped))
+			continue;
+		result += effect.source_file.filename().u8string();
+		result += effect.compiled ? " (compiled):\n" : (effect.skipped ? " (skipped):\n" : " (FAILED):\n");
+		result += effect.errors;
+		result += '\n';
+	}
+	return result;
+}
